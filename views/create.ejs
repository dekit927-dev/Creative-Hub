<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create - Creative Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div id="navbar"></div>
  <main class="container" style="max-width:640px">
    <div class="card">
      <h2>Share a new creation</h2>
      <div id="message" class="message error hidden"></div>
      <form id="create-form">
        <label for="title">Title</label>
        <input type="text" id="title" maxlength="100" placeholder="Give your work a name">
        <label for="category">Category</label>
        <select id="category"></select>
        <label for="description">Description</label>
        <textarea id="description" placeholder="Tell people about it"></textarea>
        <label for="media-type">Upload File Type</label>
        <select id="media-type">
          <option value="image" selected>Photo / Image (JPG, PNG, GIF, WEBP)</option>
          <option value="video">Video (MP4, WebM, MOV, MKV)</option>
          <option value="audio">Audio (MP3, WAV, OGG, M4A)</option>
        </select>

        <label for="image" id="file-label">Choose File (Photo, Video, or Audio)</label>
        <input type="file" id="image" accept="image/*,video/*,audio/*,.mp4,.webm,.mov,.mkv,.ogv,.avi,.mp3,.wav,.ogg,.m4a,.jpg,.jpeg,.png,.gif,.webp">

        <!-- Live Preview Container -->
        <div id="preview-wrap" class="hidden" style="margin-top:14px; border-radius:12px; overflow:hidden; background:var(--blue-pale); border:1px solid var(--blue-border); padding:12px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span id="preview-badge" class="tag" style="margin:0;">Preview</span>
            <span id="preview-size" class="muted" style="font-size:0.8rem; font-weight:600;"></span>
          </div>
          <img id="preview-img" class="hidden" style="width:100%; max-height:360px; object-fit:contain; border-radius:8px; display:block;" alt="Photo preview">
          <video id="preview-video" class="hidden" style="width:100%; max-height:360px; border-radius:8px; display:block;" controls playsinline></video>
          <audio id="preview-audio" class="hidden" style="width:100%; margin-top:6px; display:block;" controls></audio>
        </div>

        <button class="btn full" type="submit" id="submit-btn" style="margin-top:20px;">Create</button>
      </form>
    </div>
  </main>
  <div id="footer"></div>
  <script src="js/main.js"></script>
  <script src="js/create.js"></script>
</body>
</html>
