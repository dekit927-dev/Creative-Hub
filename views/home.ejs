  <main class="container">
    <div class="page-title">
      <h1>Creative Feed</h1>
      <a class="btn small" href="create.html">+ Share your work</a>
    </div>
    <div class="chips" id="chips"></div>
    <div id="feed" class="grid"></div>
  </main>

  <!-- Footer details like Image 3 -->
  <div id="footer"></div>

  <script src="/js/main.js?v=2"></script>
  <script src="/js/home.js?v=2"></script>
