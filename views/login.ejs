<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in - Creative Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="card auth-card">
      <a class="logo" href="index.html"><span class="logo-mark">C</span>Creative Hub</a>
      <h2>Welcome back</h2>
      <p class="muted">Log in to see what creators are sharing.</p>
      <div id="message" class="message error hidden"></div>
      <form id="login-form">
        <label for="email">Email</label>
        <input type="email" id="email" placeholder="you@example.com" autocomplete="email">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label for="password" style="margin-bottom:0;">Password</label>
          <a href="forgot-password.html" style="font-size:0.83rem; color:var(--blue-primary); font-weight:600;">Forgot password?</a>
        </div>
        <input type="password" id="password" placeholder="Your password" autocomplete="current-password" style="margin-top:6px;">
        <button class="btn full" type="submit" id="submit-btn">Log in</button>
      </form>
      <div id="unverified-box" class="card hidden" style="margin-top:14px; padding:14px; background:rgba(37, 99, 235, 0.08); border:1px solid rgba(37, 99, 235, 0.25); border-radius:10px; text-align:left;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
          <strong style="color:var(--blue-navy); font-size:0.92rem;">Account Not Verified</strong>
        </div>
        <p id="unverified-desc" class="muted" style="font-size:0.83rem; margin:0 0 10px; line-height:1.45;">
          Didn't receive your verification email? You can verify your account instantly and log in right away:
        </p>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <button class="btn small full" id="login-instant-verify-btn" type="button" style="display:inline-flex; align-items:center; justify-content:center; gap:6px; background:#10B981; border-color:#10B981; font-weight:700;">
            <svg class="svg-icon sm" viewBox="0 0 24 24" style="stroke:#ffffff;"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Instant Verify &amp; Log In</span>
          </button>
          <a class="btn small full secondary hidden" id="login-direct-verify-link" href="#" style="text-align:center;">
            Open Verification Link
          </a>
          <button class="btn small full secondary" id="login-resend-btn" type="button">Resend Verification Email</button>
        </div>
      </div>
      <p class="muted" style="margin-top:16px">New here? <a href="register.html">Create an account</a></p>
      <p class="muted" style="font-size:0.85rem">Demo Student: <code>sonam@sherubtse.edu.bt</code> / <code>password123</code> &middot; Admin: <code>admin@sherubtse.edu.bt</code> / <code>password123</code></p>
    </div>
  </div>
  <script src="js/main.js"></script>
  <script src="js/auth.js"></script>
</body>
</html>
