<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in - Creative Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="card auth-card">
      <a class="logo" href="index.html"><span class="logo-mark">C</span>Creative Hub</a>
      <h2>Welcome back</h2>
      <p class="muted">Log in to see what creators are sharing.</p>
      <div id="message" class="message error hidden"></div>
      <form id="login-form">
        <label for="email">Email</label>
        <input type="email" id="email" placeholder="you@example.com" autocomplete="email">
        <label for="password">Password</label>
        <input type="password" id="password" placeholder="Your password" autocomplete="current-password">
        <button class="btn full" type="submit" id="submit-btn">Log in</button>
      </form>
      <p class="muted" style="margin-top:16px">New here? <a href="register.html">Create an account</a></p>
      <p class="muted" style="font-size:0.85rem">Demo account: alice@example.com / password123</p>
    </div>
  </div>
  <script src="js/main.js"></script>
  <script src="js/auth.js"></script>
</body>
</html>
