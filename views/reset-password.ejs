<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset Password - Creative Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="card auth-card">
      <a class="logo" href="index.html"><span class="logo-mark">C</span>Creative Hub</a>
      <h2>Set new password</h2>
      <p class="muted">Please enter and confirm your new password below (at least 6 characters).</p>
      
      <div id="message" class="message error hidden"></div>
      
      <form id="reset-form">
        <label for="password">New Password</label>
        <input type="password" id="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
        <label for="confirm_password">Confirm New Password</label>
        <input type="password" id="confirm_password" placeholder="Repeat your new password" required minlength="6" autocomplete="new-password">
        <button class="btn full" type="submit" id="submit-btn" style="margin-top:10px;">Update Password</button>
      </form>
      
      <p class="muted" style="margin-top:20px; text-align:center;">
        <a href="login.html">Back to Log in</a>
      </p>
    </div>
  </div>

  <script src="js/main.js"></script>
  <script>
    const token = getParam("token");
    const form = document.getElementById("reset-form");

    if (!token) {
      showMessage("message", "Missing or invalid password reset link. Please request a new one.");
      document.getElementById("submit-btn").disabled = true;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideMessage("message");
      const password = document.getElementById("password").value;
      const confirm_password = document.getElementById("confirm_password").value;

      if (!password || password.length < 6) {
        return showMessage("message", "Password must be at least 6 characters.");
      }
      if (password !== confirm_password) {
        return showMessage("message", "Passwords do not match.");
      }

      const btn = document.getElementById("submit-btn");
      btn.disabled = true;
      btn.textContent = "Updating password...";

      try {
        const res = await api("/api/reset-password", {
          method: "POST",
          body: { token, password, confirm_password }
        });
        showMessage("message", res.message || "Password updated successfully! Redirecting to login...", "info");
        setTimeout(() => {
          window.location.href = "login.html?reset=true";
        }, 1500);
      } catch (err) {
        showMessage("message", err.message);
        btn.disabled = false;
        btn.textContent = "Update Password";
      }
    });
  </script>
</body>
</html>
