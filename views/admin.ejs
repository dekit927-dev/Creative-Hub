<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard & Analytics — CreativeHub Sherubtse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>

<body class="admin-page">
  <!-- Standard Top Navigation -->
  <div id="navbar"></div>

  <!-- Admin Main Layout -->
  <div class="admin-layout">
    <!-- Left Navigation Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-sidebar-title">Admin Management</div>
      <a href="#overview" class="admin-nav-item active" data-tab="overview">
        Dashboard Overview
      </a>
      <a href="#analytics" class="admin-nav-item" data-tab="analytics">
        Analytics Overview
      </a>
      <a href="#rankings" class="admin-nav-item" data-tab="rankings">
        Creator Rankings
      </a>
      <a href="#content" class="admin-nav-item" data-tab="content">
        Content Analytics
      </a>
      <div class="admin-sidebar-title" style="margin-top:10px;">Platform Moderation</div>
      <a href="#users" class="admin-nav-item" data-tab="users">
        User Management
      </a>
      <a href="#creations" class="admin-nav-item" data-tab="creations">
        Creative Works
      </a>
      <a href="#comments" class="admin-nav-item" data-tab="comments">
        Comment Moderation
      </a>
      <a href="#reports" class="admin-nav-item" data-tab="reports">
        Reports Queue <span class="nav-badge hidden" id="sidebar-reports-badge">0</span>
      </a>
      <a href="#categories" class="admin-nav-item" data-tab="categories">
        Category Management
      </a>
      <div style="margin-top:auto; padding-top:16px; border-top:1px solid var(--line);">
        <a href="javascript:void(0)" onclick="logout()" class="admin-nav-item" style="color:var(--danger)">
          Logout
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main">
      <!-- Top Filter Bar -->
      <div class="filter-bar">
        <div class="filter-group">
          <span>Date Range:</span>
          <select id="period-select" onchange="handlePeriodChange()">
            <option value="today">Today</option>
            <option value="7d">Last 7 Days</option>
            <option value="30d" selected>Last 30 Days</option>
            <option value="90d">Last 90 Days</option>
            <option value="month">This Month</option>
            <option value="year">This Year</option>
            <option value="all">All Time</option>
            <option value="custom">Custom Date Range</option>
          </select>
        </div>
        <div class="filter-group hidden" id="custom-date-inputs">
          <input type="date" id="custom-start-date" aria-label="Start Date">
          <span>to</span>
          <input type="date" id="custom-end-date" aria-label="End Date">
          <button class="btn small" onclick="applyCustomDateRange()">Apply</button>
        </div>
        <div style="margin-left:auto; display:flex; gap:10px; align-items:center;">
          <span id="active-range-label" style="font-size:0.83rem; color:var(--muted); font-weight:600;">Last 30
            Days</span>
          <button class="btn small secondary" onclick="refreshCurrentTab()" id="refresh-btn">Refresh Data</button>
        </div>
      </div>

      <!-- ================= 1. DASHBOARD OVERVIEW ================= -->
      <section id="tab-overview" class="admin-section">
        <div class="admin-header">
          <div>
            <h1>Dashboard Overview</h1>
            <p>Real-time campus platform metrics, student participation, and creative engagement.</p>
          </div>
        </div>

        <!-- 10 Summary Metric Cards -->
        <div class="stat-grid" id="overview-stat-grid">
          <!-- Card 1: Total Users -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Total Users</span>
            </div>
            <div class="stat-card-value" id="stat-total-users">-</div>
            <div class="stat-card-trend trend-neutral" id="trend-total-users">Registered students</div>
          </div>
          <!-- Card 2: Active Users -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Active Users</span>
            </div>
            <div class="stat-card-value" id="stat-active-users">-</div>
            <div class="stat-card-trend" id="trend-active-users">Active in period</div>
          </div>
          <!-- Card 3: Total Creative Works -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Creations</span>
            </div>
            <div class="stat-card-value" id="stat-total-creations">-</div>
            <div class="stat-card-trend trend-neutral">Student works</div>
          </div>
          <!-- Card 4: Total Likes -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Total Likes</span>
            </div>
            <div class="stat-card-value" id="stat-total-likes">-</div>
            <div class="stat-card-trend trend-neutral">Appreciation hearts</div>
          </div>
          <!-- Card 5: Total Comments -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Comments</span>
            </div>
            <div class="stat-card-value" id="stat-total-comments">-</div>
            <div class="stat-card-trend trend-neutral">Discussions & feedback</div>
          </div>
          <!-- Card 6: Total Tracked Shares -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Tracked Shares</span>
            </div>
            <div class="stat-card-value" id="stat-total-shares">-</div>
            <div class="stat-card-trend trend-neutral">Verified share actions</div>
          </div>
          <!-- Card 7: Follow Relationships -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Follows</span>
            </div>
            <div class="stat-card-value" id="stat-total-follows">-</div>
            <div class="stat-card-trend trend-neutral">Peer connections</div>
          </div>
          <!-- Card 8: New Registrations -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">New Registrations</span>
            </div>
            <div class="stat-card-value" id="stat-new-reg">-</div>
            <div class="stat-card-trend" id="trend-new-reg">In selected period</div>
          </div>
          <!-- Card 9: Content Reports -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Pending Reports</span>
            </div>
            <div class="stat-card-value" id="stat-pending-reports">-</div>
            <div class="stat-card-trend trend-neutral"><a href="#reports" onclick="switchTab('reports')">Review queue
                →</a></div>
          </div>
          <!-- Card 10: Moderation Tasks -->
          <div class="stat-card">
            <div class="stat-card-head">
              <span class="stat-card-label">Moderation Status</span>
            </div>
            <div class="stat-card-value" id="stat-moderation-status">Active</div>
            <div class="stat-card-trend trend-neutral">Audit logging ON</div>
          </div>
        </div>

        <!-- Charts Grid -->
        <div class="chart-grid">
          <div class="chart-card">
            <div class="chart-head">
              <div>
                <h3 class="chart-title">User Growth Over Time</h3>
                <div class="chart-sub">Cumulative & daily student account registrations</div>
              </div>
            </div>
            <div class="chart-body">
              <canvas id="userGrowthChart"></canvas>
            </div>
          </div>

          <div class="chart-card">
            <div class="chart-head">
              <div>
                <h3 class="chart-title">Platform Activity Trends</h3>
                <div class="chart-sub">Daily creations, likes, comments, and tracked shares</div>
              </div>
            </div>
            <div class="chart-body">
              <canvas id="platformActivityChart"></canvas>
            </div>
          </div>

          <div class="chart-card">
            <div class="chart-head">
              <div>
                <h3 class="chart-title">Category Distribution</h3>
                <div class="chart-sub">Student submissions broken down by creative field</div>
              </div>
            </div>
            <div class="chart-body">
              <canvas id="categoryChart"></canvas>
            </div>
          </div>

          <div class="chart-card">
            <div class="chart-head">
              <div>
                <h3 class="chart-title">Engagement Composition</h3>
                <div class="chart-sub">Breakdown of Total Engagement (Likes vs Comments vs Shares)</div>
              </div>
            </div>
            <div class="chart-body">
              <canvas id="engagementPieChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Quick Activity Feeds -->
        <div class="admin-two-col-grid" style="margin-top:20px;">
          <div class="chart-card">
            <div class="chart-head">
              <h3 class="chart-title">Recent Student Registrations</h3>
              <a href="#users" onclick="switchTab('users')" class="btn small secondary">All Users →</a>
            </div>
            <div class="table-wrap" style="box-shadow:none; border:none; margin:0;">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Joined</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="overview-recent-users">
                  <tr>
                    <td colspan="4" style="text-align:center;">Loading recent registrations...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="chart-card">
            <div class="chart-head">
              <h3 class="chart-title">Recent Creative Activity</h3>
              <a href="#creations" onclick="switchTab('creations')" class="btn small secondary">All Posts →</a>
            </div>
            <div class="table-wrap" style="box-shadow:none; border:none; margin:0;">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Creation</th>
                    <th>Creator</th>
                    <th>Category</th>
                    <th>Engagement</th>
                  </tr>
                </thead>
                <tbody id="overview-recent-activity">
                  <tr>
                    <td colspan="4" style="text-align:center;">Loading recent posts...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 2. ANALYTICS OVERVIEW ================= -->
      <section id="tab-analytics" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Analytics Overview</h1>
            <p>Deep-dive engagement trends, category adoption, and creator dynamics.</p>
          </div>
        </div>

        <div class="chart-card" style="margin-bottom:24px;">
          <div class="chart-head">
            <div>
              <h3 class="chart-title">Cross-Platform Activity Distribution</h3>
              <div class="chart-sub">Time-series comparison across all creative interactions</div>
            </div>
          </div>
          <div class="chart-body" style="min-height:340px;">
            <canvas id="analyticsDeepActivityChart"></canvas>
          </div>
        </div>

        <div class="admin-two-col-grid">
          <div class="chart-card">
            <div class="chart-head">
              <h3 class="chart-title">Category Popularity & Share</h3>
              <div class="chart-sub">Detailed percentage breakdown of uploaded works</div>
            </div>
            <div id="category-analytics-list" style="margin-top:12px;"></div>
          </div>
          <div class="chart-card">
            <div class="chart-head">
              <h3 class="chart-title">Engagement Metrics Summary</h3>
              <div class="chart-sub">Interaction ratio per creative work</div>
            </div>
            <div id="engagement-metrics-summary" style="margin-top:12px;"></div>
          </div>
        </div>
      </section>

      <!-- ================= 3. CREATOR RANKINGS & LEADERBOARD ================= -->
      <section id="tab-rankings" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Creator Leaderboard & Rankings</h1>
            <p>Celebrate and monitor the most active, popular, and engaged student creators in Sherubtse College.</p>
          </div>
          <div>
            <button class="btn secondary" onclick="openCreatorCompareModal()">Compare Creators</button>
          </div>
        </div>

        <!-- Transparent Formula Banner -->
        <div class="formula-banner">
          <div>
            <strong>Transparent Engagement Formula:</strong> Total Engagement = Likes Received + Comments Received +
            Tracked Shares Received.
            <div style="font-size:0.82rem; color:var(--muted); margin-top:2px;">
              Only public creative activities are included. Rankings reflect genuine peer recognition and creative
              output.
            </div>
          </div>
        </div>

        <!-- 5 Essential Ranking Tabs -->
        <div class="tab-group" id="ranking-type-tabs">
          <button class="tab-btn active" data-type="highest_engagement"
            onclick="changeRankingType('highest_engagement')">Highest Engagement</button>
          <button class="tab-btn" data-type="most_posts" onclick="changeRankingType('most_posts')">Most
            Posts</button>
          <button class="tab-btn" data-type="most_likes" onclick="changeRankingType('most_likes')">Most Likes
            Received</button>
          <button class="tab-btn" data-type="most_comments" onclick="changeRankingType('most_comments')">Most
            Comments Received</button>
          <button class="tab-btn" data-type="most_shares" onclick="changeRankingType('most_shares')">Most
            Shares</button>
          <button class="tab-btn" data-type="most_followers" onclick="changeRankingType('most_followers')">Most
            Followers</button>
        </div>

        <!-- Ranking Controls & Limits -->
        <div
          style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
          <div style="display:flex; gap:8px; align-items:center;">
            <span style="font-size:0.88rem; font-weight:600; color:var(--muted);">Show:</span>
            <button class="btn small secondary limit-btn" onclick="setRankingLimit(5)">Top 5</button>
            <button class="btn small limit-btn active" onclick="setRankingLimit(10)">Top 10</button>
            <button class="btn small secondary limit-btn" onclick="setRankingLimit(20)">Top 20</button>
          </div>
          <div>
            <input type="text" id="ranking-search" placeholder="Search creators in list..."
              oninput="filterRankingsTable()"
              style="padding:6px 14px; border-radius:8px; font-size:0.88rem; width:220px;">
          </div>
        </div>

        <!-- Horizontal Bar Chart for Top Creators -->
        <div class="chart-card" style="margin-bottom:24px;">
          <div class="chart-head">
            <h3 class="chart-title" id="ranking-chart-title">Top Creators by Engagement</h3>
            <div class="chart-sub">Visual ranking comparison</div>
          </div>
          <div class="chart-body" style="min-height:300px;">
            <canvas id="rankingBarChart"></canvas>
          </div>
        </div>

        <!-- Rankings Table -->
        <div class="table-wrap">
          <table class="data-table">
            <thead id="rankings-table-head">
              <!-- Dynamically populated based on active ranking type -->
            </thead>
            <tbody id="rankings-table-body">
              <tr>
                <td colspan="7" style="text-align:center;">Loading creator rankings...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= 4. CONTENT ANALYTICS ================= -->
      <section id="tab-content" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Content Analytics & Popular Posts</h1>
            <p>Analyze how individual creative works perform across likes, feedback, and campus sharing.</p>
          </div>
        </div>

        <!-- Content Filters -->
        <div class="filter-bar" style="margin-bottom:18px;">
          <div class="filter-group">
            <span>Category:</span>
            <select id="content-category-filter" onchange="loadContentAnalytics()">
              <option value="">All Categories</option>
            </select>
          </div>
          <div class="filter-group">
            <span>Sort By:</span>
            <select id="content-sort-by" onchange="loadContentAnalytics()">
              <option value="engagement" selected>Total Engagement</option>
              <option value="likes">Most Likes</option>
              <option value="comments">Most Comments</option>
              <option value="shares">Most Shares</option>
              <option value="date">Publication Date</option>
            </select>
          </div>
          <div class="filter-group">
            <span>Order:</span>
            <select id="content-order" onchange="loadContentAnalytics()">
              <option value="DESC" selected>Highest to Lowest</option>
              <option value="ASC">Lowest to Highest</option>
            </select>
          </div>
        </div>

        <!-- Content Analytics Table -->
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Work</th>
                <th>Creator</th>
                <th>Category</th>
                <th>Published</th>
                <th>Likes</th>
                <th>Comments</th>
                <th>Shares</th>
                <th>Total Engagement</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="content-table-body">
              <tr>
                <td colspan="10" style="text-align:center;">Loading content analytics...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= 5. USER MANAGEMENT ================= -->
      <section id="tab-users" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>User Management</h1>
            <p>Manage registered students, view creative profiles, and handle account statuses.</p>
          </div>
        </div>

        <div class="filter-bar">
          <div class="filter-group">
            <input type="text" id="user-search-input" placeholder="Search by name, username, or email..."
              oninput="debounceUserSearch()" style="width:280px;">
          </div>
          <div class="filter-group">
            <span>Status:</span>
            <select id="user-status-filter" onchange="loadUsersList()">
              <option value="all">All Statuses</option>
              <option value="active">Active</option>
              <option value="suspended">Suspended</option>
            </select>
          </div>
          <div class="filter-group">
            <span>Role:</span>
            <select id="user-role-filter" onchange="loadUsersList()">
              <option value="all">All Roles</option>
              <option value="user">Student (User)</option>
              <option value="admin">Administrator</option>
            </select>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Student</th>
                <th>Email</th>
                <th>Joined</th>
                <th>Creations</th>
                <th>Likes Received</th>
                <th>Followers</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="users-table-body">
              <tr>
                <td colspan="8" style="text-align:center;">Loading users...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= 6. CREATIVE-WORK MANAGEMENT ================= -->
      <section id="tab-creations" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Creative-Work Management</h1>
            <p>Review uploaded works, inspect student contributions, and remove inappropriate content.</p>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Preview</th>
                <th>Title</th>
                <th>Creator</th>
                <th>Category</th>
                <th>Uploaded</th>
                <th>Engagement</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="creations-mgmt-body">
              <tr>
                <td colspan="7" style="text-align:center;">Loading creative works...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= 7. COMMENT MODERATION ================= -->
      <section id="tab-comments" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Comment Moderation</h1>
            <p>Ensure student conversations remain respectful, constructive, and supportive.</p>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Work</th>
                <th>Commenter</th>
                <th>Comment Content</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="comments-mgmt-body">
              <tr>
                <td colspan="5" style="text-align:center;">Loading recent comments...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= 8. REPORTS QUEUE ================= -->
      <section id="tab-reports" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Content Reports Queue</h1>
            <p>Review reports submitted by students for community guidelines compliance.</p>
          </div>
        </div>

        <div class="tab-group" id="reports-filter-tabs">
          <button class="tab-btn active" onclick="loadReportsQueue('pending')">Pending Reports</button>
          <button class="tab-btn" onclick="loadReportsQueue('resolved')">Resolved</button>
          <button class="tab-btn" onclick="loadReportsQueue('dismissed')">Dismissed</button>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Reported Item</th>
                <th>Reporter</th>
                <th>Reason</th>
                <th>Reported On</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="reports-table-body">
              <tr>
                <td colspan="7" style="text-align:center;">Loading moderation reports...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= 9. CATEGORY MANAGEMENT ================= -->
      <section id="tab-categories" class="admin-section hidden">
        <div class="admin-header">
          <div>
            <h1>Category Management</h1>
            <p>Organize creative disciplines (Digital Art, Photography, Traditional Painting, Literature, etc.).</p>
          </div>
          <div>
            <button class="btn" onclick="openAddCategoryModal()">+ Add Category</button>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th>Description</th>
                <th>Creations Count</th>
                <th>Created At</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="categories-table-body">
              <tr>
                <td colspan="6" style="text-align:center;">Loading categories...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <!-- ================= MODALS ================= -->

  <!-- Individual Creator Analytics Modal -->
  <div class="modal-backdrop hidden" id="creator-modal">
    <div class="modal-card">
      <button class="modal-close" onclick="closeCreatorModal()">&times;</button>
      <div id="creator-modal-content">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <!-- Creator Compare Modal -->
  <div class="modal-backdrop hidden" id="compare-modal">
    <div class="modal-card" style="max-width:820px;">
      <button class="modal-close" onclick="closeCompareModal()">&times;</button>
      <h2>Compare Creators Head-to-Head</h2>
      <p style="color:var(--muted); font-size:0.9rem; margin-top:-6px;">Select two or more creators to compare their
        engagement metrics across the same timeframe.</p>

      <div style="margin:16px 0; display:flex; gap:10px; flex-wrap:wrap;" id="compare-selector-container">
        <!-- Checkboxes of creators -->
      </div>

      <div style="margin-bottom:18px;">
        <button class="btn" onclick="executeCreatorComparison()">Compare Selected Creators</button>
      </div>

      <div id="compare-results" class="hidden">
        <div style="min-height:280px; margin-bottom:20px;">
          <canvas id="compareBarChart"></canvas>
        </div>
        <div class="table-wrap" id="compare-table-wrap"></div>
      </div>
    </div>
  </div>

  <!-- User Status Modal (Suspend / Reactivate) -->
  <div class="modal-backdrop hidden" id="user-status-modal">
    <div class="modal-card" style="max-width:480px;">
      <button class="modal-close" onclick="closeUserStatusModal()">&times;</button>
      <h2 id="user-status-modal-title">Change Account Status</h2>
      <p id="user-status-modal-desc" style="color:var(--muted); font-size:0.92rem;"></p>
      <div style="margin:16px 0;">
        <label style="font-weight:600; font-size:0.88rem; display:block; margin-bottom:6px;">Reason for action (logged
          in audit trail):</label>
        <textarea id="user-status-reason" rows="3" style="width:100%; border-radius:8px; padding:10px;"
          placeholder="Optional administrative note..."></textarea>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:10px;">
        <button class="btn secondary" onclick="closeUserStatusModal()">Cancel</button>
        <button class="btn" id="confirm-user-status-btn" onclick="submitUserStatusChange()">Confirm</button>
      </div>
    </div>
  </div>

  <!-- Add / Edit Category Modal -->
  <div class="modal-backdrop hidden" id="category-modal">
    <div class="modal-card" style="max-width:480px;">
      <button class="modal-close" onclick="closeCategoryModal()">&times;</button>
      <h2 id="category-modal-title">Add Category</h2>
      <div style="margin:16px 0; display:flex; flex-direction:column; gap:12px;">
        <div>
          <label style="font-weight:600; font-size:0.88rem; display:block; margin-bottom:4px;">Category Name:</label>
          <input type="text" id="cat-name-input" placeholder="e.g. Traditional Textiles" style="width:100%;">
        </div>
        <div>
          <label style="font-weight:600; font-size:0.88rem; display:block; margin-bottom:4px;">Description:</label>
          <textarea id="cat-desc-input" rows="3" placeholder="Category focus & guidelines..."
            style="width:100%;"></textarea>
        </div>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:10px;">
        <button class="btn secondary" onclick="closeCategoryModal()">Cancel</button>
        <button class="btn" onclick="saveCategory()">Save Category</button>
      </div>
    </div>
  </div>

  <!-- Resolve Report Modal -->
  <div class="modal-backdrop hidden" id="report-modal">
    <div class="modal-card" style="max-width:520px;">
      <button class="modal-close" onclick="closeReportModal()">&times;</button>
      <h2>Review Content Report</h2>
      <div id="report-modal-details" style="margin:14px 0; font-size:0.92rem; color:var(--muted);"></div>
      <div style="margin:14px 0;">
        <label style="font-weight:600; font-size:0.88rem; display:block; margin-bottom:4px;">Resolution Note:</label>
        <textarea id="report-resolution-note" rows="2" style="width:100%;"
          placeholder="Explanation of moderation decision..."></textarea>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:18px;">
        <button class="btn secondary" onclick="submitReportResolution('dismissed', false)">Dismiss Report</button>
        <button class="btn" style="background:var(--danger);" onclick="submitReportResolution('resolved', true)">Remove
          Content & Resolve</button>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/js/main.js"></script>
  <script src="/js/admin.js"></script>
</body>

</html>