# CreativeHub Environment Variables Example
# Duplicate this file to .env and fill in your values

# Server Port
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creative_hub_db
DB_USER=postgres
DB_PASS=your_db_password
DB_SSL=false

# Full Database URL (Optional, overrides individual DB_* variables if set)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Application Live URL (Used for generating email verification & password reset links)
APP_URL=http://localhost:3000

# Express Session Secret
SESSION_SECRET=your_long_random_session_secret_key_here

# SMTP / Email Service Configuration
# If credentials are not set, emails will be safely logged to the console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="CreativeHub Sherubtse" <noreply@sherubtse.edu.bt>
